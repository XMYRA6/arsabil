# Veritabanı — PostgreSQL bağlantı URL'i
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/arsabil"

# NextAuth
NEXTAUTH_SECRET=your-32-char-random-secret-here  # Generate: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Sentry (boş bırakılırsa Sentry tamamen devre dışı)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=  # yalniz CI/build'de source map upload icin
