generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              String             @default("USER")
  createdAt         DateTime           @default(now())
  accounts          Account[]
  listings          Listing[]
  receivedMessages  Message[]          @relation("ReceivedMessages")
  sentMessages      Message[]          @relation("SentMessages")
  offers            Offer[]
  projects          Project[]
  reports           Report[]
  sessions          Session[]
  bio               String?
  linkedin          String?
  website           String?
  isVerified        Boolean            @default(false)
  isBanned          Boolean            @default(false)
  plan              String             @default("FREE")
  emailPrefs        String             @default("{}")
  notifications     Notification[]
  compareShares     CompareShare[]
  favorites         Favorite[]
  studioScenarios   StudioScenario[]
  studioShareTokens StudioShareToken[]
  whatsappPhone     String?            @unique
  parselDosyalari   ParselDosyasi[]
  projeKartlari     ProjeKarti[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Report {
  id                String   @id @default(cuid())
  title             String
  totalApartments   Int
  apartmentSizeSqm  Float
  luxLevelModifier  Float
  landShareRatio    Float
  minApartmentPrice Float
  landCost          Float
  userId            String
  createdAt         DateTime @default(now())
  listing           Listing?
  user              User     @relation(fields: [userId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  reportId   String?
  senderId   String
  receiverId String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  entityId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompareShare {
  id          String   @id @default(cuid())
  token       String   @unique @default(cuid())
  userId      String
  scenarioIds String[]
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GlobalSettings {
  id                      String   @id @default("settings")
  excavationLowPercent    Float    @default(0.01)
  excavationMediumPercent Float    @default(0.02)
  qualityStandard         Float    @default(1.0)
  qualityMedium           Float    @default(1.2)
  qualityLux              Float    @default(1.4)
  defaultUnitPrice        Float    @default(12000)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model ProfitLevel {
  id        String   @id @default(cuid())
  label     String
  value     Float
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RiskLevel {
  id        String   @id @default(cuid())
  label     String
  value     Float
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Listing {
  id                 String     @id @default(cuid())
  reportId           String?    @unique
  userId             String
  city               String?
  district           String?
  notes              String?
  isActive           Boolean    @default(true)
  status             String     @default("PENDING")
  title              String?
  address            String?
  phone              String?
  description        String?
  price              Float?
  landSizeSqm        Float?
  zoning             String?
  type               String     @default("KAT_KARSILIGI")
  titleDeed          String?
  photos             String[]   @default([])
  lat                Float?
  lng                Float?
  neighborhood       String?
  adaNo              String?
  parselNo           String?
  parcelAreaSqm      Float?
  parcelQuality      String?
  parcelGeometry     Json?
  parcelVerifiedAt   DateTime?
  parcelLookupStatus String?
  faultDistanceM     Int?
  floodQ100          Boolean?
  riskSnapshotAt     DateTime?
  createdAt          DateTime   @default(now())
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  report             Report?    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  offers             Offer[]
  favorites          Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Offer {
  id           String   @id @default(cuid())
  listingId    String
  bidderId     String
  offeredShare Float
  message      String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  bidder       User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Project {
  id          String     @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  akifMemory  String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarios   Scenario[]
}

model Scenario {
  id              String   @id @default(cuid())
  name            String
  projectId       String
  luxLevel        Float
  apartmentSize   Float
  landShareRatio  Float
  totalApartments Int?
  arsaAlani       Float?
  riskLevel       Float
  builderProfit   Float
  iksaMode        String   @default("off")
  iksaPercentage  Float?   @default(0)
  iksaManualTL    Float?   @default(0)
  marketPrice     Float?   @default(0)
  fdTotal         Float
  fdPerM2         Float
  mi              Float
  ma              Float
  totalCost       Float
  fa              Float?
  fabirim         Float?
  sdx             Float?
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DistrictPrice {
  id                       String   @id @default(cuid())
  il                       String
  ilce                     String
  avgSalesPricePerM2       Float
  avgUnitConstructionPrice Float
  avgLandPricePerM2        Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([il, ilce])
  @@index([il])
}

model StudioScenario {
  id                   String                  @id @default(cuid())
  userId               String
  name                 String
  description          String?
  parcelIdentity       String?
  baseInputHash        String
  parcelSourceStatus   String                  @default("demo")
  currentVersionNumber Int                     @default(1)
  isArchived           Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions             StudioScenarioVersion[]
  shareTokens          StudioShareToken[]

  @@index([userId])
  @@index([isArchived])
}

model StudioScenarioVersion {
  id             String             @id @default(cuid())
  scenarioId     String
  versionNumber  Int
  snapshotJson   String
  snapshotHash   String
  schemaVersion  Int                @default(1)
  summaryNotes   String?
  needsRebalance Boolean            @default(false)
  warningCount   Int                @default(0)
  createdAt      DateTime           @default(now())
  scenario       StudioScenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  shareTokens    StudioShareToken[]

  @@unique([scenarioId, versionNumber])
  @@index([scenarioId])
  @@index([snapshotHash])
}

// Faz 4A gap fix (2026-08-22): Once bellek ici (in-memory) bir dizideydi —
// sunucu yeniden baslayinca/deploy edilince kayboluyordu, serverless
// ortamda istekler arasinda bile kalici degildi. Notification.entityId ile
// AYNI desen: gevsek (FK constraint'siz) String referans — audit kaydi,
// referans verdigi StudioScenario silinse/arsivlense bile BAGIMSIZ kalir.
model StudioScenarioAuditLog {
  id            String   @id @default(cuid())
  userId        String
  scenarioId    String
  versionNumber Int?
  eventType     String
  metadataJson  String?
  createdAt     DateTime @default(now())

  @@index([scenarioId])
  @@index([userId])
}

model StudioShareToken {
  id         String                @id @default(cuid())
  token      String                @unique
  scenarioId String
  versionId  String
  userId     String
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime              @default(now())
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario   StudioScenario        @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  version    StudioScenarioVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([scenarioId])
  @@index([versionId])
}

// SP1 — fotogerçekçi render cache + harcama denetim izi. Her satır bir
// GERÇEK üretilen (cache miss) render'ı temsil eder; cache hit yeni
// satır YAZMAZ — bu yüzden aylık harcama toplamı bu tablonun estCostUsd
// toplamından güvenle hesaplanabilir (StudioScenarioAuditLog ile aynı
// gevşek/FK'siz desen — userId'ye referans verir ama Cascade bağlamaz).
model StudioRenderCache {
  id         String   @id @default(cuid())
  userId     String
  cacheKey   String
  imageUrl   String
  estCostUsd Float
  createdAt  DateTime @default(now())

  @@unique([userId, cacheKey])
  @@index([userId])
  @@index([createdAt])
}

model MarketListing {
  id              String                    @id @default(cuid())
  source          String
  sourceListingId String
  sourceUrl       String
  title           String?
  description     String?                   @db.Text
  price           Float?
  currency        String                    @default("TRY")
  areaSqm         Float?
  pricePerSqm     Float?
  listingType     String
  imarStatus      String?
  il              String?
  ilce            String?
  mahalle         String?
  adaNo           String?
  parselNo        String?
  lat             Float?
  lng             Float?
  geoPrecision    String?
  photoUrls       String[]                  @default([])
  listedAt        DateTime?
  status          String                    @default("active")
  firstSeenAt     DateTime                  @default(now())
  lastSeenAt      DateTime                  @default(now())
  dupeOfId        String?
  rawJson         Json?
  priceHistory    MarketListingPricePoint[]

  @@unique([source, sourceListingId])
  @@index([il, ilce, mahalle])
  @@index([listingType, status])
  @@index([lat, lng])
}

// NOTE: il/ilçe kapsam satırlarındaki (ilce/mahalle NULL) benzersizlik DB'de
// fonksiyonel bir unique index ile zorlanır — bkz.
// prisma/migrations/20260830120000_add_area_price_stat/migration.sql
// ("AreaPriceStat_scope_unique", COALESCE(ilce,'')/COALESCE(mahalle,'') üzerinde).
// Prisma şeması bunu ifade edemez; el-yazımı migration'daki ekstra index'e izin verir.
model AreaPriceStat {
  id                String   @id @default(cuid())
  il                String
  ilce              String?
  mahalle           String?
  scope             String // "il" | "ilce" | "mahalle"
  medianPricePerSqm Float
  p25               Float
  p75               Float
  sampleCount       Int
  computedAt        DateTime

  @@unique([il, ilce, mahalle])
}

model AreaPriceTrend {
  id                String   @id @default(cuid())
  il                String
  ilce              String?
  mahalle           String?
  scope             String
  monthBucket       DateTime
  medianPricePerSqm Float
  sampleCount       Int
  computedAt        DateTime

  @@unique([il, ilce, mahalle, monthBucket])
  @@index([il, ilce, mahalle])
}

model Neighborhood {
  id                String   @id @default(cuid())
  il                String
  ilce              String
  mahalle           String
  geojson           Json?
  emlakjetRiskScore Float?
  source            String
  updatedAt         DateTime @updatedAt

  @@unique([il, ilce, mahalle])
}

model MarketListingPricePoint {
  id         String        @id @default(cuid())
  listingId  String
  price      Float
  observedAt DateTime      @default(now())
  listing    MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model CrawlRun {
  id               String    @id @default(cuid())
  source           String
  il               String
  category         String
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  pagesFetched     Int       @default(0)
  listingsFound    Int       @default(0)
  listingsUpserted Int       @default(0)
  blocked          Boolean   @default(false)
  notes            String?
}

model WhatsappConversation {
  id            String   @id @default(cuid())
  phone         String   @unique
  state         Json
  lastMessageId String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model WhatsappSubscription {
  id                 String    @id @default(cuid())
  phone              String
  il                 String
  ilce               String
  mahalle            String
  createdAt          DateTime  @default(now())
  lastDigestMonth    String?
  lastAlertAt        DateTime?
  lastAlertDirection String?

  @@unique([phone, il, ilce, mahalle])
  @@index([il, ilce, mahalle])
}

model AkifTurnLog {
  id               String   @id @default(cuid())
  conversationId   String
  turn             Int
  model            String
  promptTokens     Int
  completionTokens Int
  estCostUsd       Float
  intent           String
  tool             String?
  createdAt        DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model DistrictDemographics {
  id                       String   @id @default(cuid())
  il                       String
  ilce                     String
  dataYear                 Int
  population               Int?
  populationGrowthPerMille Float?
  medianAge                Float?
  avgHouseholdSize         Float?
  source                   String
  fetchedAt                DateTime
  updatedAt                DateTime @updatedAt

  @@unique([il, ilce])
  @@index([il])
}

model AkifVoiceSessionLog {
  id          String   @id @default(cuid())
  userId      String
  startedAt   DateTime
  endedAt     DateTime @default(now())
  durationSec Int
  toolCalls   Int      @default(0)
  estCostUsd  Float    @default(0)
  endReason   String

  @@index([userId, startedAt])
  @@index([startedAt])
}

model AkifVoiceSession {
  id             String    @id
  userId         String
  status         String    @default("active")
  reconnectCount Int       @default(0)
  createdAt      DateTime  @default(now())
  endedAt        DateTime?

  @@index([userId, createdAt])
}

model AkifPendingAction {
  id                String    @id @default(cuid())
  userId            String
  sessionId         String
  kind              String
  payload           Json
  createdAt         DateTime  @default(now())
  consumedAt        DateTime?
  undoToken         String?   @unique
  undoUntil         DateTime?
  createdScenarioId String?
  createdProjectId  String?

  @@index([userId, createdAt])
}

model AkifVoiceTurnLog {
  id         String   @id @default(cuid())
  sessionId  String
  createdAt  DateTime @default(now())
  tool       String?
  intent     String?
  estCostUsd Float    @default(0)

  @@index([sessionId])
}

// Akif-5c Aşama B — WhatsApp Proje Kartları. Kalıcı veri YALNIZ bağlı hesaba
// (userId) aittir; telefon yalnız User.whatsappPhone ve PhoneClaim'de yaşar.
model ParselDosyasi {
  id        String   @id @default(cuid())
  userId    String
  il        String
  ilce      String
  mahalle   String
  ada       String
  parsel    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  olgular   ParselOlgu[]
  projeler  ProjeKartiParsel[]

  @@unique([userId, il, ilce, mahalle, ada, parsel])
}

model ParselOlgu {
  id              String        @id @default(cuid())
  parselDosyasiId String
  key             String
  value           Json
  source          String
  recordedAt      DateTime      @default(now())
  supersededAt    DateTime?
  parselDosyasi   ParselDosyasi @relation(fields: [parselDosyasiId], references: [id], onDelete: Cascade)

  @@index([parselDosyasiId, key, supersededAt])
}

model ProjeKarti {
  id          String   @id @default(cuid())
  userId      String
  name        String?
  inputs      Json
  status      String   @default("aktif")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parseller   ProjeKartiParsel[]
  revizyonlar ProjeRevizyon[]

  @@index([userId, createdAt])
}

model ProjeKartiParsel {
  projeKartiId    String
  parselDosyasiId String
  projeKarti      ProjeKarti    @relation(fields: [projeKartiId], references: [id], onDelete: Cascade)
  parselDosyasi   ParselDosyasi @relation(fields: [parselDosyasiId], references: [id], onDelete: Cascade)

  @@id([projeKartiId, parselDosyasiId])
}

model ProjeRevizyon {
  id           String     @id @default(cuid())
  projeKartiId String
  field        String
  oldValue     Json?
  newValue     Json
  changedAt    DateTime   @default(now())
  channel      String
  note         String?
  projeKarti   ProjeKarti @relation(fields: [projeKartiId], references: [id], onDelete: Cascade)

  @@index([projeKartiId, changedAt])
}

model PhoneClaim {
  id        String    @id @default(cuid())
  phone     String
  tokenHash String    @unique
  draft     Json?
  expiresAt DateTime
  usedAt    DateTime?
  userId    String?
  createdAt DateTime  @default(now())

  @@index([phone])
}
