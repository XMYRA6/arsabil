# Haftalik emlakjet crawler imaji (Coolify Scheduled Task / cron servisi).
# App imajindan AYRI: Chromium + ts-node + crawler kaynagi gerekir.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production CHECKPOINT_DISABLE=1

COPY package*.json ./
# devDependencies gerekli (ts-node, typescript, @playwright/test)
RUN npm ci --include=dev --ignore-scripts

# Chromium + sistem bagimliliklari (surum package-lock'taki Playwright ile eslesir)
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

COPY prisma ./prisma
RUN npx prisma generate

COPY tsconfig.json ./
COPY src ./src
COPY crawler ./crawler
COPY scripts ./scripts

# Calistirma: DATABASE_URL (prod, ic ag) + istege bagli CRAWL_PROXY_* env'leri
CMD ["sh", "scripts/crawl-weekly.sh"]
